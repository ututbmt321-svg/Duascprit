<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Script Copy</title>
<style>
body{font-family:Arial,sans-serif;background:#111;color:#fff;padding:20px}
.box{background:#1e1e1e;border-radius:12px;padding:15px;margin:15px 0}
pre{white-space:pre-wrap;word-break:break-all;background:#000;padding:12px;border-radius:8px}
button{background:#5865f2;color:white;border:0;padding:10px 16px;border-radius:8px;font-size:15px}
button:active{transform:scale(.97)}
</style>
</head>
<body>
<h2>📋 Script Copy</h2>

<div class="box">
<pre id="s1">loadstring(game:HttpGet("https://raw.githubusercontent.com/anuragaming1/anura/refs/heads/main/soclo.lua"))()</pre>
<button onclick="copy('s1',this)">Copy</button>
</div>

<div class="box">
<pre id="s2">loadstring(game:HttpGet("https://rawscripts.net/raw/HEAD-OF-HEI-Jujutsu-Shenanigans-JujutsuerV2-92468"))()</pre>
<button onclick="copy('s2',this)">Copy</button>
</div>

<div class="box">
<pre id="s3">loadstring(game:HttpGet("https://pastefy.app/3mumddu5/raw"))()</pre>
<button onclick="copy('s3',this)">Copy</button>
</div>

<script>
function copy(id,btn){
  navigator.clipboard.writeText(document.getElementById(id).innerText);
  const old=btn.innerText;
  btn.innerText="Đã copy ✓";
  setTimeout(()=>btn.innerText=old,1200);
}
</script>
</body>
</html>
